#!/bin/bash

#----------------------------------------------------------------------
#
# defaults
#
#----------------------------------------------------------------------

CC="g++"

INPUT="build.cpp"
OUTPUT="plugin.exe"
DEBUG=false

#-----

FLAGS=""
FLAGS+=" -std=gnu++17"
FLAGS+=" -fno-exceptions"
FLAGS+=" -Wall" # -Wfatal-errors"
FLAGS+=" -Wl,--as-needed"

#FLAGS=" -static"
#FLAGS+=" -Wl,-Bsymbolic"
#FLAGS+=" -pthread"
#FLAGS+=" -static-libgcc"
#FLAGS+=" -static-libstdc++"

INC=""
INC+=" -I../src"

PRELIB=""

LIB=""
LIB+=" -lm"
#LIB+=" -ldl -lrt"

ADDITIONAL=""

#----------------------------------------------------------------------
#
# print help
#
#----------------------------------------------------------------------

function print_help_and_exit {
    echo "usage: ./compile <options>"
    echo ""
    echo "  -i <path>       input file name/path"
    echo "  -o <path>       output file name/path"
    echo "  -d              debug"
    echo "  -h, -?          help"
    exit 1
}

#----------------------------------------------------------------------
#
# parse command line
#
#----------------------------------------------------------------------

if [ "$#" -eq 0 ]; then
    print_help_and_exit
fi

while getopts i:o:dh? arg
do
    A=""
    case $arg in
        i)      INPUT=$OPTARG;;
        o)      OUTPUT=$OPTARG;;
        d)      DEBUG=true;;
        h|?)    print_help_and_exit;;
        *)      exit 1;;
    esac
done

#------------------------------
# -i input
#------------------------------

INPUT_FILE=${INPUT##*/}
INPUT_BASE=${INPUT_FILE%%.*}
INPUT_EXT=${INPUT_FILE##*.}
INPUT_DIR=${INPUT%$INPUT_FILE}

#------------------------------
# -o output
#------------------------------

OUTPUT_FILE=${OUTPUT##*/}
OUTPUT_BASE=${OUTPUT_FILE%%.*}
OUTPUT_EXT=${OUTPUT_FILE##*.}
OUTPUT_DIR=${OUTPUT%$OUTPUT_FILE}

#------------------------------
# -d debug
#------------------------------

if $DEBUG
then
    FLAGS+=" -DHOLOS_DEBUG"
    FLAGS+=" -g"
    FLAGS+=" -rdynamic"
    #FLAGS+=" -export-dynamic"
    #FLAGS+=" -Wl,-Bsymbolic"
else
    FLAGS+=" -DNDEBUG"
    FLAGS+=" -O3"
    FLAGS+=" -ffast-math"
    FLAGS+=" -s"
    #FLAGS+=" -flto"
fi

#----------------------------------------------------------------------
#
# compile
#
#----------------------------------------------------------------------

$CC $INPUT -o $OUTPUT $FLAGS $INC $PRELIB $LIB $ADDITIONAL

